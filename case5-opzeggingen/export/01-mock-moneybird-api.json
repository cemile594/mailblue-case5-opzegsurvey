        "dataTableId": {
          "__rl": true,
          "value": "moneybird_invoices",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "contact_id",
              "condition": "eq",
              "keyValue": "={{ $json.contact_id || '__geen__' }}"
            }
