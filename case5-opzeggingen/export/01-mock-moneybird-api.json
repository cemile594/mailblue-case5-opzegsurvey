    {
      "id": "ca4eb705-7244-48c1-8597-e7d7e7403905",
      "name": "Auth & filter lezen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const req = $input.first().json;\nconst auth = String((req.headers || {}).authorization || '');\nconst filter = String((req.query || {}).filter || '');\n// MoneyBird-filtersyntax: \"state:open|late,contact_id:123\"\nconst parts = {};\nfor (const p of filter.split(',')) {\n  const i = p.indexOf(':');\n  if (i > 0) parts[p.slice(0, i).trim()] = p.slice(i + 1).trim();\n}\nreturn [{ json: {\n  authorized: auth.startsWith('Bearer ') && auth.length > 7,\n  contact_id: parts.contact_id || '',\n  states: parts.state ? parts.state.split('|') : [],\n  administration_id: 'adm-mailblue'\n}}];"
      }
    },
    {
      "id": "9c7e74d8-ccb9-4807-b16a-f1aa09cc12f8",
      "name": "Geautoriseerd?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      }
    },
    {
      "id": "22547f49-f305-45e6-854b-8143716c6b41",
