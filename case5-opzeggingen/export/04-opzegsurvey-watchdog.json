      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "submission_log",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "received"
            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true,
      "notes": "Alles wat binnenkwam (status received) maar nooit op processed is gezet."
    },
    {
      "id": "e4136112-7c00-4b0e-8ddd-75cbb3035f47",
      "name": "Ouder dan 10 minuten?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const grens = Date.now() - 10 * 60 * 1000;\nconst vast = $input.all()\n  .map(i => i.json)\n  .filter(r => r.submission_id && r.received_at && new Date(r.received_at).getTime() < grens);\nif (vast.length === 0) return [];\nconst regels = vast.map(r => '• ' + r.submission_id + ' (' + (r.email || 'geen e-mail') + ', ontvangen ' + r.received_at + ')');\nreturn [{ json: {\n  channel: '#cs-alerts',\n  severity: 'critical',\n  submission_id: vast.map(r => r.submission_id).join(','),\n  text: ':warning: *' + vast.length + ' opzegging(en) niet volledig verwerkt*\\n' + regels.join('\\n') + '\\nActie: verwerk handmatig of herstart de inzending; ruwe payload staat in submission_log.',\n  source: 'watchdog',\n  created_at: new Date().toISOString()\n}}];"
      },
      "notes": "Geeft 0 items terug als alles in orde is, dan stopt de flow vanzelf."
    },
