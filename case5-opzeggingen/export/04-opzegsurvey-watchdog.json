      ],
      "parameters": {
        "jsCode": "const ids = String($('Ouder dan 10 minuten?').first().json.submission_id || '').split(',').filter(Boolean);\nreturn ids.map(id => ({ json: { submission_id: id } }));"
      },
      "notes": "Eén item per gemelde inzending, zodat de volgende stap ze allemaal markeert."
    },
